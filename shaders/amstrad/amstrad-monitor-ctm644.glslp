# Amstrad CTM644 -- colour monitor, CPC 664 / 6128 era (1985).
# Tube 3701B22-TC20 (service manual part 170307), 37cm / 14in, 24kV EHT,
# slot mask, B22 = standard P22 colour triad.
# Built for this core's NATIVE 800x280 output. Leave sugarbox_monitor = color.

shaders = 12

shader0 = "shaders/cpc-video-bandwidth.glsl"
filter_linear0 = true
scale_type0 = source
scale0 = 1.0

shader1 = "../crt/shaders/guest/lut/lut.glsl"
filter_linear1 = false
scale_type1 = source
scale1 = 1.0

textures = "SamplerLUT1;SamplerLUT2;SamplerLUT3"
SamplerLUT1 = "../crt/shaders/guest/lut/sony_trinitron1.png"
SamplerLUT1_linear = true
SamplerLUT2 = "../crt/shaders/guest/lut/sony_trinitron2.png"
SamplerLUT2_linear = true
SamplerLUT3 = "../crt/shaders/guest/lut/other1.png"
SamplerLUT3_linear = true

shader2 = "../crt/shaders/guest/color-profiles.glsl"
filter_linear2 = false
scale_type2 = source
scale2 = 1.0

shader3 = "../crt/shaders/guest/d65-d50.glsl"
filter_linear3 = false
scale_type3 = source
scale3 = 1.0

shader4 = "../crt/shaders/guest/afterglow.glsl"
filter_linear4 = false
scale_type4 = source
scale4 = 1.0

shader5 = "../crt/shaders/guest/avg-lum0.glsl"
filter_linear5 = false
scale_type5 = source
scale5 = 1.0

shader6 = "../crt/shaders/guest/avg-lum.glsl"
filter_linear6 = false
scale_type6 = source
scale6 = 1.0
mipmap_input6 = true

shader7 = "../crt/shaders/guest/linearize.glsl"
filter_linear7 = false
scale_type7 = source
scale7 = 1.0
float_framebuffer7 = true

shader8 = "../crt/shaders/guest/blur_horiz.glsl"
filter_linear8 = false
scale_type8 = source
scale8 = 1.0
float_framebuffer8 = true

shader9 = "../crt/shaders/guest/blur_vert.glsl"
filter_linear9 = false
scale_type9 = source
scale9 = 1.0
float_framebuffer9 = true

shader10 = "../crt/shaders/guest/linearize_scanlines.glsl"
filter_linear10 = true
scale_type10 = source
scale10 = 1.0
float_framebuffer10 = true

shader11 = "../crt/shaders/guest/crt-guest-dr-venom.glsl"
filter_linear11 = true
scale_type11 = viewport
scale_x11 = 1.0
scale_y11 = 1.0

# --- mask: slot, not dot. Documented for both colour tubes. --------------
shadowMask = "-1.0"
slotmask = "0.55"
slotwidth = "2.0"
double_slot = "1.0"
slotms = "1.0"

# --- scanlines faint: on these tubes you see mask texture, not scanlines --
gsl = "0.0"
beam_min = "1.12"
beam_max = "1.05"
beam_size = "0.75"

warpX = "0.030"
warpY = "0.040"
glow = "0.03"
brightboost = "1.30"

# Afterglow short: B22/KB22 is the ordinary P22 TV triad, not a long
# persistence phosphor. P* is "more is less".
SW = "1.0"
AR = "0.03"
PR = "0.20"
AG = "0.03"
PG = "0.20"
AB = "0.03"
PB = "0.20"

# --- geometry: era-typical, NOT measured (no deflection angle in manual) --
csize = "0.010"
bsize = "600.0"
h_sharp = "5.25"
s_sharp = "0.00"
gamma_out = "2.4"

# 280 < the 400.0 trigger so interlace never fires; pinned off anyway.
# Do NOT set inter = 0.0 -- the gate is "inter <= height".
interm = "0.0"

# --- CPC video bandwidth (ADJUSTABLE) ------------------------------------
# Live in RetroArch: F1 -> Shaders -> Parameters -> "CPC video bandwidth".
# Range 0.0-4.0 texels, 0 disables the pass. A Mode 0 pixel is 4 texels wide
# in this core's output, a Mode 1 pixel is 2, so sigma ~1.1 spreads across
# about half a Mode 0 pixel. This pass exists because crt-guest's h_sharp
# cannot reach that far: its kernel is exp2(-h_sharp*w*w), so even at the
# h_sharp floor of 1.0 a tap 3 texels out weighs about 0.002.
cpc_bw_sigma = "1.10"
