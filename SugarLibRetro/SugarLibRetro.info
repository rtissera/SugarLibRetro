# Firmware
# ROMs live under <system>/amstradcpc/ROM/. The 6128 pair is what the
# default model needs; the rest are only required if you switch model with
# the amstradcpc_model core option, so they are marked optional. amsdos.rom
# is the disk operating system ROM (expansion slot 7) -- without it the
# machine has no disk firmware at all and RUN"/CAT fall through to the
# cassette handler, so disks cannot be read.
firmware_count = 8

firmware0_desc = "amstradcpc/ROM/os6128.rom (CPC 6128 OS, also used by 6128+/GX4000)"
